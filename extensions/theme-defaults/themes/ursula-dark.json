	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6B6660", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "meta.embedded.assembly"],
			"settings": { "foreground": "#B9C99A" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "support.constant"],
			"settings": { "foreground": "#E5C07B" }
		},
		{
			"scope": ["constant.character", "constant.other"],
			"settings": { "foreground": "#D8BE8E" }
		},
		{
			"scope": ["keyword", "keyword.control", "keyword.operator.expression", "storage.modifier", "variable.language.this", "variable.language.super"],
			"settings": { "foreground": "#C2A878" }
		},
		{
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#9A958C" }
		},
		{
			"scope": ["punctuation", "meta.brace", "punctuation.definition.parameters"],
			"settings": { "foreground": "#9A958C" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#E8DCC4" }
		},
		{
			"scope": ["entity.name.class", "entity.name.type", "entity.name.namespace", "support.type", "support.class"],
			"settings": { "foreground": "#D8BE8E" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#C2A878" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#D8BE8E", "fontStyle": "italic" }
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": { "foreground": "#F4F1EC" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#C9BFA9" }
		},
		{
			"scope": ["support.variable.property", "meta.property-name", "variable.other.property", "variable.other.object.property"],
			"settings": { "foreground": "#B9C99A" }
		},
		{
			"scope": ["entity.name.section", "markup.heading"],
			"settings": { "foreground": "#C2A878", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#7FB069" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#E06C75" }
		},
		{
			"scope": ["markup.changed"],
			"settings": { "foreground": "#E5C07B" }
		},
		{
			"scope": ["string.regexp", "constant.regexp"],
			"settings": { "foreground": "#D8BE8E" }
		},
		{
			"scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
			"settings": { "foreground": "#E5C07B" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#E06C75" }
		},
		{
			"scope": ["text.html.markdown", "text.html"],
			"settings": { "foreground": "#F4F1EC" }
		}
	]
}
