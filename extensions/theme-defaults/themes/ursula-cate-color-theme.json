		"textLink.activeForeground": "#e0683c",
		"textBlockQuote.background": "#221d18",
		"textBlockQuote.border": "#e0683c",
		"textCodeBlock.background": "#1c1813",
		"textPreformat.foreground": "#d9a441",
		"textSeparator.foreground": "#3a2f26",
